# Copy this file to .env and fill it in. .env holds passwords: it is NOT uploaded to GitHub.

# ---- InfluxDB (created on the very first start; changing these later does not change InfluxDB) ----
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change-me-at-least-8-chars
INFLUX_ORG=dpx
INFLUX_BUCKET=factory
INFLUX_RETENTION=365d
INFLUX_TOKEN=change-me-to-a-long-random-token

# ---- MQTT broker (Mosquitto, in this compose) ----
# users made on every start: esp32 (the board, may publish) and web (website + Telegraf, read only)
MQTT_ESP32_PASS=change-me-esp32
MQTT_WEB_PASS=change-me-web

# Telegraf listens as the read-only user. Another broker? e.g. ssl://xxxx.emqxsl.com:8883
MQTT_SERVER=tcp://mosquitto:1883
MQTT_USER=web
MQTT_PASS=change-me-web
MQTT_TOPIC_BOARD=group3/dpx/line1/board
MQTT_TOPIC_STATUS=group3/dpx/line1/status
MQTT_TOPIC_EVENTS=group3/dpx/line1/events
MQTT_TOPIC_MINUTES=group3/dpx/line1/minutes
LINE_ID=line1

# ---- ports on this computer (change if something else already uses them) ----
MQTT_PORT=1883
MQTT_WS_PORT=9001
WEB_PORT=8080
INFLUX_PORT=8086
GRAFANA_PORT=3000
PG_PORT=5432

# ---- Grafana login ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ---- PostgreSQL / TimescaleDB: the main store (users are made on the very first start) ----
# reader = read only (Claude's MCP, sheets-sync); telegraf = writes the data; admin = everything
PG_ADMIN_USER=factory_admin
PG_ADMIN_PASSWORD=change-me-admin
PG_DB=factory
PG_TELEGRAF_PASS=change-me-telegraf
PG_READER_PASS=change-me-reader

# ---- Google Sheet summary (google-sheets/sheets_webapp.gs); leave SHEETS_URL empty to turn it off ----
SHEETS_URL=https://script.google.com/macros/s/PASTE_YOUR_DEPLOYMENT_ID/exec
SHEETS_KEY=change-me-to-a-secret
SHEETS_EVERY_MIN=15
SHEETS_HOURLY_DAYS=14
SHEETS_EVENTS_ROWS=500
SHEETS_EVENTS_GAP_S=10

# ---- Cloudflare Tunnel: the website from anywhere (docker compose --profile tunnel up -d) ----
# Cloudflare dashboard -> Zero Trust -> Networks -> Tunnels -> Create a tunnel (Cloudflared) -> copy the token
CLOUDFLARE_TUNNEL_TOKEN=
